# Токен бота из @BotFather. Без него работает демо-режим (вход под демо-пользователем).
BOT_TOKEN=123456789:AAF...

# Ваши telegram id (числовые) через запятую — они получат права администратора (модерация жалоб, удаление заказов, восстановление заблокированных).
ADMIN_TG_IDS=123456789,987654321

# Публичный адрес приложения (для ссылок в уведомлениях админу в Telegram), напр. https://myservice.onrender.com
BASE_URL=

# Канал-витрина заказов: бот публикует в него каждый новый заказ с кнопкой «Открыть».
# Бот должен быть администратором канала. По умолчанию @podrabotka_orders
CHANNEL_ID=@podrabotka_orders

# Сколько новых жалоб на заказы пользователя блокирует аккаунт (по умолчанию 3)
BLOCK_THRESHOLD=3

# База данных. Если НЕ задано — используется SQLite-файл server/p24.db.
# Задайте URL PostgreSQL (например, Neon/Supabase), чтобы данные переживали редеплои:
# postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/p24?sslmode=require
P24_DB=

# Стоимость продвижения заказа в Telegram Stars (по умолчанию 100)
BOOST_PRICE_STARS=100