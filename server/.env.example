# Токен бота из @BotFather. Без него работает демо-режим (вход под демо-пользователем).
BOT_TOKEN=123456789:AAF...

# Ваши telegram id (числовые) через запятую — они получат права администратора (модерация жалоб, удаление заказов, восстановление заблокированных).
ADMIN_TG_IDS=123456789,987654321

# Публичный адрес приложения (для ссылок в уведомлениях админу в Telegram), напр. https://myservice.onrender.com
BASE_URL=

# Сколько новых жалоб на заказы пользователя блокирует аккаунт (по умолчанию 3)
BLOCK_THRESHOLD=3